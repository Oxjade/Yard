<resources>
    <style name="Theme.Yard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/yard_launch_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Yard.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/yard_launch_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Yard</item>
    </style>
</resources>
