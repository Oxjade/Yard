# Yard v2 embedded server. For local development, copy this file to .env.local.
# Never set YARD_DEMO_AUTH or YARD_DEMO_ADMIN on a deployment people can reach:
# they turn on sign-in without a password.
# Server-only secrets: never prefix these with NEXT_PUBLIC_.

YARD_DATA_DIR=                               # empty = ~/.yard/<repo>-<hash>, outside the repo (mode 0700)
YARD_PUBLIC_URL=http://localhost:3000        # OAuth redirect URIs and the CSRF origin; https:// makes cookies Secure and __Host- prefixed
YARD_SESSION_SECRET=                         # ≥ 32 random bytes, base64url. Dev: generated into secrets.json
YARD_ENCRYPTION_KEY=                         # exactly 32 random bytes, base64. Dev: generated into secrets.json
YARD_ENCRYPTION_KEY_PREVIOUS=                # optional, decrypt-only during rotation
YARD_DEMO_AUTH=                              # empty = off in production. 1 = demo shopper and brand sign-in in production; requires YARD_SEED_DEMO=1 (boot fails otherwise)
YARD_DEMO_ADMIN=                             # empty = off. 1 together with YARD_DEMO_AUTH=1 = demo admin sign-in in production
YARD_SEED_DEMO=                              # empty = off in production: only categories and holidays are seeded (no brands, products or admins; see README). 1 only for an isolated demo deployment; requires YARD_DEMO_AUTH=1 (boot fails otherwise)
YARD_TRUSTED_PROXY_HOPS=0                    # reverse proxies in front of Yard that set X-Forwarded-For; 0 = ignore the header (§5.1)
YARD_RATE_API_PER_MIN=                       # global per-IP budget for /api/* in src/proxy.ts (production default 300 a minute, development 3000); route limits apply on top
YARD_RATE_AUTH_PER_MIN=                      # global per-IP budget for /api/auth/* (production default 60 a minute, development 600)
YARD_MAX_JSON_BODY_BYTES=                    # largest declared JSON API body (default 1048576); uploads keep their own caps
YARD_REQUEST_LOG=                            # one JSON line per API request (method, path, status, ms, id); empty = on in production, 1/0 to force
YARD_SHUTDOWN_GRACE_MS=                      # SIGTERM drain before the database closes regardless (default 25000; keep systemd TimeoutStopSec above it)
YARD_SOCIAL_SANDBOX=1                       # dev-only simulated Instagram/TikTok; ignored when NODE_ENV=production
YARD_RESET_DB=0                              # 1 = wipe and reseed on boot (dev only)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/dark

# Database. Empty = the embedded PGlite under YARD_DATA_DIR (development, tests, npm run start:demo).
# Set = Postgres through node-postgres (every real deployment; production requires it). The server
# never migrates Postgres at boot: run `npm run db:migrate` first (deploy/release.sh does).
# Create the database with LC_COLLATE 'C' LC_CTYPE 'C.UTF-8' TEMPLATE template0 (PGlite's sort order).
DATABASE_URL=                                # postgres://user:password@127.0.0.1:5432/yard
YARD_PG_POOL_MAX=5                           # connections per server process (production 5, staging 3)
YARD_ENV_NAME=                               # label for logs and /api/health (production, staging); default NODE_ENV
YARD_ALLOW_PGLITE_PRODUCTION=                # 1 = allow NODE_ENV=production on PGlite (local tests of the production build only)
YARD_ALLOW_HTTP=                             # 1 = allow an http:// YARD_PUBLIC_URL on a Postgres production server (local tests only)

# Payments. off = checkout is closed ("Payments open soon"; carts, browsing, accounts, Studio work):
# production's default. paystack = PAYSTACK_SECRET_KEY charges. bachs = BACHS_SECRET_KEY charges
# through Bachs hosted checkout (docs/BACHS.md). stub = nothing is charged
# (development's default without a key; in production only with YARD_SEED_DEMO=1).
YARD_PAYMENTS=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Bachs (YARD_PAYMENTS=bachs): sk_live_… key, the webhook endpoint's whsec_… signing secret,
# optional API base (default https://api.bachs.io) and charge currencies (default NGN; NGN, GHS, KES, USD).
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_API_BASE=
BACHS_CHARGE_CURRENCIES=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v23.0                # verify against Meta's changelog when keys are added
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_USE_PKCE=1

# ---------------------------------------------------------------------------------------------
# Not used by the embedded server. Placeholders kept from the frontend phase for a future
# hosted backend (managed Postgres, real identity provider, payments, object storage, search).
# ---------------------------------------------------------------------------------------------

# Auth (Better Auth)
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Cache and jobs
# REDIS_URL=redis://localhost:6379

# Other payment providers
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_HASH=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Media (Cloudflare R2, S3-compatible)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Search (Meilisearch)
# MEILI_HOST=
# MEILI_MASTER_KEY=

# Product analytics (public key — safe in the browser)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=

# Monitoring
# SENTRY_DSN=
