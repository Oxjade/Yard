# Not used in the frontend phase. Planned for the backend phase — copy to .env.local.
# Server-only secrets: never prefix these with NEXT_PUBLIC_.

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/nocturne

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Cache and jobs
REDIS_URL=redis://localhost:6379

# Payments — provider abstraction; enable the providers you are eligible for
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media (Cloudflare R2, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Search (Meilisearch)
MEILI_HOST=
MEILI_MASTER_KEY=

# Product analytics (public key — safe in the browser)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Monitoring
SENTRY_DSN=
