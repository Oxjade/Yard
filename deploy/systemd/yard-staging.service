# Yard staging: Next.js standalone server on 127.0.0.1:3001 behind Caddy.
# NOT enabled at boot. It starts on a staging deploy; `sudo systemctl stop yard-staging` frees its
# memory (~250-400 MB) without touching production. Lower CPU priority; killed first under memory pressure.
[Unit]
Description=Yard marketplace (staging)
Documentation=file:///opt/yard/kit/README.md
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service
StartLimitIntervalSec=300
StartLimitBurst=5
# Nothing to run until the first release is deployed.
ConditionPathExists=/srv/yard/staging/current/server.js

[Service]
Type=simple
# Its own user: staging and production never share a uid, secrets, data or /proc.
User=yard-staging
Group=yard-staging
# Secrets and settings (root:yard-staging 0640). PORT=3001, HOSTNAME=127.0.0.1, DATABASE_URL, YARD_*.
EnvironmentFile=/etc/yard/staging.env
# Memory: V8 heap 256 MB inside a 400 MB ceiling (native memory, sharp/libvips, buffers on top).
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=MALLOC_ARENA_MAX=2 VIPS_CONCURRENCY=1 UV_THREADPOOL_SIZE=4
WorkingDirectory=/srv/yard/staging/current
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5
# SIGTERM: live streams get `bye restart` and end, Next finishes in-flight requests, then exits.
# TimeoutStopSec + boot must stay under Caddy's lb_try_duration (30 s) so a deploy never shows a 502.
KillSignal=SIGTERM
TimeoutStopSec=15
MemoryHigh=340M
MemoryMax=400M
MemorySwapMax=256M
OOMScoreAdjust=300
Nice=5
CPUWeight=50
IOWeight=50
UMask=0077
# Hardening: the release is read-only; only the data dir (uploads, image cache) is writable.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/yard/staging
# The other environment's secrets, data and releases, and the backups, do not exist in here.
InaccessiblePaths=-/etc/yard/production.env -/var/lib/yard/production -/srv/yard/production -/etc/yard/backup.env -/var/backups/yard
# Other processes (the other environment, Postgres, root's tools) are invisible in /proc.
ProtectProc=invisible
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
