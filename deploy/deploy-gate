#!/usr/bin/env bash
# deploy-gate ENV
#   The forced command of a CI deploy key. setup.sh installs one key per environment, each for its
#   own Unix user: /home/deploy-ENV/.ssh/authorized_keys holds
#     restrict,command="/opt/yard/bin/deploy-gate ENV" ssh-ed25519 …
#   The key never gets a shell, a pty, port forwarding or scp; it can only run:
#
#     info                         YARD_DOMAIN and the service states
#     upload ENV SHA SHA256        stdin -> /srv/yard/ENV/incoming/SHA.tar.gz (max 400 MB), checksum verified
#     release ENV SHA              /opt/yard/bin/release ENV SHA     (detached, see below)
#     rollback ENV                 /opt/yard/bin/rollback ENV        (previous release only; detached)
#     status ENV [RUN]             the log tail and result of a release/rollback run (default: the latest)
#     health ENV                   GET /api/health of ENV
#
#   ENV in a command must equal the environment the key is bound to, and the gate only runs as that
#   environment's deploy user (deploy-ENV owns /srv/yard/ENV and nothing else), so the staging key
#   (used by unreviewed pushes to v3) can never touch production. Anything else exits 126.
#
#   release and rollback run DETACHED from the SSH session (setsid, own log file under
#   /srv/yard/ENV/logs/): the gate streams the log and exits with the run's exit code, but if the
#   connection drops (runner lost, job cancelled) the run still finishes, health check and automatic
#   rollback included. The first line printed is "run RUN-ID"; `status ENV RUN-ID` reports it later.
set -euo pipefail
# shellcheck source=lib/common.sh
. "${YARD_COMMON:-/opt/yard/lib/common.sh}"

bound=${1:-}
valid_env "$bound" || { echo "deploy-gate: key is not bound to an environment" >&2; exit 126; }
cmdline=${SSH_ORIGINAL_COMMAND:-}
refuse() { echo "deploy-gate: refused: $*" >&2; exit 126; }
me=$(id -un)
[[ "$me" == "$(env_deploy_user "$bound")" || "$me" == root ]] || refuse "the $bound key must log in as $(env_deploy_user "$bound") (this is $me)"

[[ ${#cmdline} -le 200 ]] || refuse "command too long"
[[ "$cmdline" =~ ^[a-z0-9\ -]*$ ]] || refuse "unexpected characters"
read -r -a words <<<"$cmdline"
((${#words[@]} > 0)) || refuse "no command (this key has no shell)"
verb=${words[0]}
want_env() {
  [[ "${words[1]:-}" == "$bound" ]] || refuse "this key may only act on $bound"
}

MAX_UPLOAD=$((400 * 1024 * 1024))
LOGS="$YARD_SRV/$bound/logs"

# run_detached KIND LABEL CMD...: starts CMD in its own session, output to $LOGS/KIND-TIME-LABEL.log,
# exit code to the matching .status file; follows the log until it finishes and exits with its code.
run_detached() {
  local kind=$1 label=$2 id logf st tp
  shift 2
  [[ -d "$LOGS" && -w "$LOGS" ]] || refuse "$LOGS is missing (re-run setup.sh)"
  id="$kind-$(date -u +%Y%m%dt%H%M%Sz)-$label"
  logf="$LOGS/$id.log"
  st="$LOGS/$id.status"
  umask 077
  : >"$logf"
  echo "run $id"
  # shellcheck disable=SC2016 # expanded by the detached shell
  YARD_DETACHED=1 setsid nohup bash -c '
    st=$1 logf=$2
    shift 2
    "$@" >>"$logf" 2>&1 </dev/null
    rc=$?
    printf "%s\n" "$rc" >"$st.tmp" && mv -f "$st.tmp" "$st"
  ' yard-run "$st" "$logf" "$@" >/dev/null 2>&1 </dev/null &
  tail -n +1 -F "$logf" 2>/dev/null &
  tp=$!
  while [[ ! -s "$st" ]]; do sleep 1; done
  sleep 1
  kill "$tp" 2>/dev/null || true
  wait "$tp" 2>/dev/null || true
  exit "$(cat "$st")"
}

case "$verb" in
  info)
    ((${#words[@]} == 1)) || refuse "usage: info"
    printf 'YARD_DOMAIN=%s\n' "$(env_get "$YARD_ETC/domain.env" YARD_DOMAIN)"
    printf 'bound=%s\n' "$bound"
    for e in "${YARD_ENVS[@]}"; do
      printf '%s=%s current=%s\n' "$(env_service "$e")" "$("$SYSTEMCTL" is-active "$(env_service "$e")" 2>/dev/null || true)" "$(current_release "$e")"
    done
    ;;
  upload)
    ((${#words[@]} == 4)) || refuse "usage: upload ENV SHA SHA256"
    want_env
    sha=${words[2]}
    sum=${words[3]}
    valid_sha "$sha" || refuse "bad commit id"
    [[ "$sum" =~ ^[0-9a-f]{64}$ ]] || refuse "bad sha256"
    dir="$YARD_SRV/$bound/incoming"
    umask 027
    # Old partial uploads (a dropped connection) are cleared after a day.
    find "$dir" -maxdepth 1 -type f -mmin +1440 -delete 2>/dev/null || true
    part="$dir/.$sha.tar.gz.part"
    head -c $((MAX_UPLOAD + 1)) >"$part"
    size=$(stat -c %s "$part")
    if ((size > MAX_UPLOAD)); then
      rm -f "$part"
      refuse "upload larger than 400 MB"
    fi
    have=$(sha256sum "$part" | awk '{ print $1 }')
    if [[ "$have" != "$sum" ]]; then
      rm -f "$part"
      echo "deploy-gate: checksum mismatch (got $have)" >&2
      exit 1
    fi
    mv -f "$part" "$dir/$sha.tar.gz"
    printf '%s  %s.tar.gz\n' "$sum" "$sha" >"$dir/$sha.sha256"
    echo "uploaded $sha ($size bytes)"
    ;;
  release)
    ((${#words[@]} == 3)) || refuse "usage: release ENV SHA"
    want_env
    valid_sha "${words[2]}" || refuse "bad commit id"
    run_detached release "${words[2]}" "$YARD_OPT/bin/release" "$bound" "${words[2]}"
    ;;
  rollback)
    ((${#words[@]} == 2)) || refuse "usage: rollback ENV"
    want_env
    run_detached rollback previous "$YARD_OPT/bin/rollback" "$bound"
    ;;
  status)
    ((${#words[@]} == 2 || ${#words[@]} == 3)) || refuse "usage: status ENV [RUN]"
    want_env
    run=${words[2]:-}
    if [[ -z "$run" ]]; then
      run=$(find "$LOGS" -maxdepth 1 -type f -name '*.log' \( -name 'release-*' -o -name 'rollback-*' \) -printf '%T@ %f\n' 2>/dev/null | sort -rn | awk 'NR == 1 { sub(/\.log$/, "", $2); print $2 }')
      [[ -n "$run" ]] || { echo "status: none"; exit 0; }
    fi
    [[ "$run" =~ ^(release|rollback)-[0-9]{8}t[0-9]{6}z-[a-z0-9]{1,40}$ ]] || refuse "bad run id"
    [[ -f "$LOGS/$run.log" ]] || { echo "status: unknown run $run"; exit 0; }
    tail -n 80 "$LOGS/$run.log"
    if [[ -s "$LOGS/$run.status" ]]; then
      echo "status: exit $(cat "$LOGS/$run.status")"
    else
      echo "status: running"
    fi
    ;;
  health)
    ((${#words[@]} == 2)) || refuse "usage: health ENV"
    want_env
    if body=$(health_json "$bound"); then
      printf '%s\n' "$body"
    else
      down='{"status":"down"}'
      printf '%s\n' "${body:-$down}"
      exit 1
    fi
    ;;
  *)
    refuse "unknown command '$verb'"
    ;;
esac
